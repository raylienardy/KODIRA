.env
.env.*
!.env.example
local.properties
key.properties
*.jks
*.keystore
*.p8
*.p12
*.key
*.pem
*.crt
*.mobileprovision

# ===== Dependencies =====
node_modules/
.pub-cache/
.dart_tool/
.packages
.flutter-plugins
.flutter-plugins-dependencies

# ===== Build Output =====
build/
dist/
out/
*.apk
*.apks
*.aab
*.aar
*.dex
*.class
*.o
*.so
*.jar
!.gradle/wrapper/gradle-wrapper.jar
.cxx/
captures/

# ===== Gradle =====
.gradle/
gradle-app.setting
!gradle-wrapper.jar

# ===== IDE & Editor =====
.idea/
*.iml
*.iws
*.ipr
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.settings/
.project
.classpath
*.swp
*.swo

# ===== Logs & Cache =====
*.log
*.hmap
*.ipa
DerivedData/
coverage/
/test_reports/

# ===== Auto-generated =====
GeneratedPluginRegistrant.java
flutter_*.png
linked_*.ds
unlinked.ds
unlinked_spec.ds

# ===== OS Files =====
.DS_Store
Thumbs.db
desktop.ini
*.stackdump

# ===== Temp Files =====
*.tmp
*.bak
*.orig
*.rej

